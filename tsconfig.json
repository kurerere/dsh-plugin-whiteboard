{
  // Type-checks both faces in one program. The Host face only uses DOM-free
  // Node globals that also exist in lib.dom (Response, AbortSignal, URL).
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    // The emitted declarations are committed and their bytes are recorded in
    // notes/harness.md, so the newline must not depend on the OS tsc runs on: without
    // this, a Windows build writes CRLF, the tree reads as dirty after every
    // `pnpm run types`, and the recorded hashes stop describing a checkout.
    "newLine": "lf",
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable", "ESNext.Disposable"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
